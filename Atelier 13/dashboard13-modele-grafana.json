        "query": "loki",
        "refresh": 1,
        "current": {}
      },
      {
        "name": "run",
        "label": "Lot A13",
        "type": "textbox",
        "query": "RUN_A13_A_REMPLACER",
        "current": {
          "text": "RUN_A13_A_REMPLACER",
          "value": "RUN_A13_A_REMPLACER"
        },
        "skipUrlSync": false
      },
      {
        "name": "dataset",
        "label": "Jeu de donnees",
        "type": "custom",
        "query": "access,movies",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "access",
            "value": "access",
            "selected": false
          },
          {
            "text": "movies",
            "value": "movies",
            "selected": false
          }
        ]
      },
      {
        "name": "phase",
        "label": "Phase",
        "type": "custom",
        "query": "normal,incident,recovery",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "normal",
            "value": "normal",
            "selected": false
          },
          {
            "text": "incident",
            "value": "incident",
            "selected": false
          },
          {
            "text": "recovery",
            "value": "recovery",
            "selected": false
