  "panels": [
    {
      "id": 1,
      "title": "P00 — Perimetre et methode",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Sources A09/A11 conservees. Lot **synthetique instrumente** : normal → incident → recovery. Les KPI utilisent la periode selectionnee en Instant ; les heatmaps utilisent les observations individuelles. Aucune latence HTTP n’est fournie. Les variables filtrent uniquement les panneaux qui les referencent."
      }
    },
    {
      "id": 2,
      "title": "P01 — Lignes observees (JSON metier)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "editorMode": "code",
          "expr": "sum (count_over_time(\n{job=\"atelier11\",format=\"json\"} |= \"${run}\"\n| json kind=\"a13_kind\", dataset_value=\"source_dataset\", phase_value=\"phase\"\n| __error__=\"\"\n| kind=\"record\"\n| dataset_value=~\"${dataset:regex}\"\n| phase_value=~\"${phase:regex}\"\n[$__range]\n))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "maxLines": 2000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
