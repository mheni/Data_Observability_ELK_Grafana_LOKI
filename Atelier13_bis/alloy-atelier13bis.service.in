[Unit]
Description=Grafana Alloy - atelier 13 bis isole
After=network-online.target
Wants=network-online.target

[Service]
User=alloy
Group=alloy
ExecStart=@ALLOY@ run --server.http.listen-addr=127.0.0.1:12346 --storage.path=/var/lib/alloy-atelier13bis /etc/alloy-atelier13bis/config.alloy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
